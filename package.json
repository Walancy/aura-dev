{
  "name": "aura-dev",
  "version": "1.0.0",
  "description": "Aura Dev - Native Project Management & IDE Desktop App with Claude and AGY CLI",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:orchestrator": "cargo build --release --manifest-path rust/orchestrator/Cargo.toml && node scripts/copy-orchestrator.js",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:ui": "vite build",
    "build": "npm run build:orchestrator && tsc -p tsconfig.electron.json && vite build",
    "dev:ui": "vite --port 5185",
    "start": "npm run build:orchestrator && tsc -p tsconfig.electron.json && electron dist-electron/main.js"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@vscode/codicons": "^0.0.46-24",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.46.0",
    "mermaid": "^12.1.0",
    "node-pty": "^1.1.0",
    "ogl": "^1.0.11",
    "polygon-clipping": "^0.15.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vscode-symbols": "^0.0.20",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.1",
    "typescript": "^5.7.3",
    "vite": "^8.3.0"
  }
}
